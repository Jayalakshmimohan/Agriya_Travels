# GEMINI_API_KEY: Required for Gemini AI API calls (travel news, trip planner).
# Get a free key at https://aistudio.google.com/apikey — real keys start "AIza".
# Without a valid key the AI features fall back to their local templates.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Which Gemini model the AI services call. Optional — defaults to
# gemini-2.5-flash. Set this rather than hardcoding a model id in the code:
# an invalid id fails silently and the endpoints just serve fallback content.
GEMINI_MODEL="gemini-2.5-flash"

# DATABASE_URL: Postgres connection string (Neon). Stores enquiries, generated
# itineraries, and the package catalogue mirror.
# Run `npm run db:migrate` to create the schema, `npm run db:seed` to load packages.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=verify-full"

# PORT: Port the Express server listens on. Optional — defaults to 3000.
PORT=3000

# OPEN_BROWSER: Set to "false" to stop `npm run dev` opening a browser tab.
# Never fires when NODE_ENV=production. OPEN_BROWSER_URL overrides the page,
# e.g. http://localhost:3000/admin
OPEN_BROWSER=true

# ADMIN_API_TOKEN: Gates /api/admin/* and the /admin dashboard, which expose
# customer names, phones and emails. Must be at least 16 characters — the API
# refuses to serve rather than run open. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_API_TOKEN="generate-a-long-random-token"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# WhatsApp Business Platform (optional — click-to-chat works without any of this)
#
# Leave these unset and the site behaves exactly as before: every WhatsApp
# link is a wa.me deep link the traveller taps to send. Set them and the team
# ALSO gets a push the moment a lead is created, so an enquiry is actionable
# even when the traveller never taps send.
#
# Prerequisites Meta imposes before these values exist:
#   1. A Meta Business Portfolio, business-verified.
#   2. A phone number NOT registered on the WhatsApp or WhatsApp Business app.
#      It must be deregistered there first, so this cannot be the same number
#      as WHATSAPP_NUMBER in src/data/index.ts.
#   3. An approved display name on that number — templates from numbers
#      without one are rejected.
#   4. An approved *utility* template whose body takes 8 variables, in order:
#        {{1}} lead ref   {{2}} origin    {{3}} destination  {{4}} travel date
#        {{5}} travellers {{6}} budget    {{7}} contact      {{8}} admin URL
#
# This notifies the AGENCY only. Messaging travellers proactively needs
# documented opt-in under Meta policy and the DPDP Act, which this site does
# not yet collect — see the privacy consent work before going near it.

# System user token with whatsapp_business_messaging. Prefer a permanent
# system-user token; the 24-hour developer token will expire mid-week.
WHATSAPP_API_TOKEN=""

# Phone Number ID from the WhatsApp Business Account — NOT the phone number.
WHATSAPP_PHONE_NUMBER_ID=""

# Name of the approved template, e.g. new_enquiry
WHATSAPP_TEMPLATE_NAME=""

# Template language code, must match the approved template exactly.
WHATSAPP_TEMPLATE_LANGUAGE="en"

# Who gets paged, comma-separated, country code first and no "+".
# 10-digit numbers are rejected: Meta accepts them and delivers nowhere.
WHATSAPP_TEAM_NUMBERS="919380054540,919941938222"

# Graph API version. Configurable because Meta retires versions on a schedule
# and a stale value fails at runtime.
WHATSAPP_API_VERSION="v21.0"
